# Copy to .env and adjust. Everything else is configured inside the app.

# Address and port the server listens on. 0.0.0.0 makes it reachable on your LAN.
HOST=0.0.0.0
PORT=8000

# Where the database, downloaded models, segments, exports and logs live.
DATA_DIR=./data

# First admin account, created on the first start only. Change the password in the app afterwards.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin

# Optional. Generated and stored in DATA_DIR when blank.
SECRET_KEY=

# Docker only: host folder with your audio, mounted as /audio inside the container.
AUDIO_DIR=./audio
